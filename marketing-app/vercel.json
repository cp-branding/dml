{
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/",
      "has": [{ "type": "cookie", "key": "mk_session" }],
      "dest": "/marketing-kurs-komplett.html"
    },
    {
      "src": "/(.*\\.html)",
      "has": [{ "type": "cookie", "key": "mk_session" }],
      "dest": "/$1"
    },
    { "src": "/(.*)", "dest": "/login.html" }
  ]
}
